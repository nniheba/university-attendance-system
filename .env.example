# Public: safe for the browser. Required for Supabase Auth and Realtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes
DEVICE_COOKIE_SECRET=replace-with-a-separate-secret-of-at-least-32-random-bytes

# Optional server-only session-center geocoding. Missing key = unknown place.
GEOAPIFY_API_KEY=

# Optional canonical origin used in generated QR URLs.
# Leave blank in local/Preview so the current request origin is used automatically.
# Example production value: https://attendance.example.edu
NEXT_PUBLIC_APP_URL=
